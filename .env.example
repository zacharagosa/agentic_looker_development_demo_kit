# CloudScale Enterprise — Automated SaaS Executive QBR Studio Configuration
# Copy this file to .env and populate with your Looker & GCP credentials.

LOOKER_HOST=your-instance.looker.app
LOOKER_CLIENT_ID=your-looker-api-client-id
LOOKER_CLIENT_SECRET=your-looker-api-client-secret

GCP_PROJECT=your-gcp-project-id
QBR_SA_KEY=/path/to/your/service_account_key.json
GEMINI_MODEL=gemini-3.8-flash
VERTEX_LOCATION=global

# Optional: Looker Conversational Analytics Agent ID
QBR_AGENT_ID=your-ca-agent-id

# Web Server Port
PORT=8092
